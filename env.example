GOOGLE_API_KEY="NOT_SET"
NODE_ENV="development"
AU_BEARER_TOKEN="NOT_SET"
CAPTCHA_SECRET_KEY="1x0000000000000000000000000000000AA"
# "0x4AAAAAAAbVrFdTl2rj-qe7" # test prod key
# "1x0000000000000000000000000000000AA" # always passes
# "2x0000000000000000000000000000000AA" #always fails

# ── Zoho CRM (Careers application form) ───────────────────────────────
# Read at runtime from Cloudflare via `platform.env` (NOT import.meta.env).
# Set these as encrypted secrets in the Cloudflare Pages project (Production
# + Preview). For local dev with the Cloudflare adapter, put them in `.dev.vars`.
# Used by src/routes/(light-nav)/careers/apply/+server.ts → Zoho "Applicants" module.
# Required:
ZOHO_CLIENT_ID="NOT_SET"
ZOHO_CLIENT_SECRET="NOT_SET"
ZOHO_REFRESH_TOKEN="NOT_SET"
# Optional (defaults shown in the endpoint):
# ZOHO_ACCOUNTS_DOMAIN="https://accounts.zoho.com"
# ZOHO_API_DOMAIN="https://www.zohoapis.com"
# ZOHO_APPLICANTS_MODULE="Applicants"